# Copy to .env (cp .env.example .env && chmod 600 .env). Never commit .env.

# Voice out: on a Mac, JARVIS speaks with the Mac's own built-in voice (default: Daniel, British). Free, offline, no key.
# VOICE_ENGINE=mac       (or eleven to force ElevenLabs; the default picks the Mac voice when it is there)
# MAC_VOICE=Daniel       (any voice from System Settings, Accessibility, Spoken Content)
# MAC_VOICE_RATE=180     (words per minute)
# Voice in (the Mic button) and the optional ElevenLabs voice use this key. Without it you can still type.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=QYrOVogqhHWUzdZFXf0E
# More human than the fast model. For the quickest replies use eleven_turbo_v2_5 instead.
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Lower stability and higher style make the accent and character stronger (0 to 1).
# ELEVENLABS_STABILITY=0.35
# ELEVENLABS_STYLE=0.5

# The model that talks and picks tools. Without it, JARVIS falls back to
# scoring your question against the files and shows a MODEL MISSING badge.
ANTHROPIC_API_KEY=
# JARVIS_MODEL=claude-sonnet-5-5

# 1 = invented demo data (default). 0 = your real folders.
JARVIS_DEMO=1
# Real folders, separated by ':' on macOS and Linux (';' on Windows). Read only.
# JARVIS_FOLDERS=/Users/me/Documents/Clients:/Users/me/Notes

# JARVIS_PORT=8765

# Tests only: send the model calls to a local stand-in instead of the real API.
# ANTHROPIC_BASE_URL=

# ---- Broker (optional). Practice account first. Never share these keys. ----
# Make a free Alpaca account, open the PAPER (practice) account, and generate API keys there.
# ALPACA_KEY_ID=
# ALPACA_SECRET_KEY=
# Safety limits (these are the defaults):
# ALPACA_MAX_ORDER=25            # biggest single order, in dollars
# ALPACA_MAX_ORDERS_PER_DAY=5
# Real money needs BOTH of these lines. Leave them out to stay on the practice account.
# ALPACA_MODE=live
# ALPACA_ALLOW_LIVE=yes
# Live keys are saved separately (python3 agent/setup_broker.py --live), so practice keys keep working.
# ALPACA_LIVE_KEY_ID=
# ALPACA_LIVE_SECRET_KEY=

# ---- Autopilot guardrails (these are the defaults) ----
# AUTO_DAILY_GOAL=10          # stop buying for the day once up this many dollars, to keep it
# AUTO_DAILY_LOSS=5           # stop buying for the day once down this many dollars
# AUTO_DAILY_LOSS_PCT=2       # ...or down this percent of the account, whichever comes first
# AUTO_STOP_WHEN_BEHIND=on    # stop for the day when today's losses are bigger than today's wins
# AUTO_MAX_TRADES=3           # buys per day
# AUTO_MAX_POSITIONS=2
# Every autopilot buy also gets a stop loss at the broker, GUARD_MAX_LOSS percent under the price.
# Autopilot pauses itself if, after AUTO_GRADUATE_TRADES finished trades, it is losing money on average.
# Live autopilot stays locked until the practice autopilot finishes AUTO_GRADUATE_TRADES trades (20) and makes money overall,
# AND this line is added on purpose:
# AUTO_ALLOW_LIVE=yes

# Optional: email and text alerts for REAL trading changes (practice or live account). Leave blank to keep alerts on screen and voice only.
# Gmail: turn on 2-step verification, then make an App Password at myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
# Text messages through your carrier's email gateway, for example 5551234567@vtext.com (Verizon) or @txt.att.net (AT&T) or @tmomail.net (T-Mobile)
NOTIFY_SMS_EMAIL=

# Trading alerts: which stocks JARVIS watches (comma separated) and how much money you are starting with, so alerts show sizes that fit your account.
WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,AMD,TSLA,AMZN,META,GOOGL
START_MONEY=100

# Profit guard: JARVIS sells a position (never buys) when it gives back too much of its best profit, or falls too far.
# On for the practice account. For a live account it only runs if you set PROFIT_GUARD=on on purpose. Set PROFIT_GUARD=off to stop it.
PROFIT_GUARD=on
GUARD_GIVEBACK=40
GUARD_MAX_LOSS=3
GUARD_MIN_PROFIT=0.25

# Optional cloud voice: Fish Audio. Make a free account at fish.audio, create an API key under Developers,
# and copy the long code at the end of a voice's page address. If this fails or runs out of credit,
# JARVIS uses the free voice on your computer instead.
FISH_API_KEY=
FISH_VOICE_ID=
# FISH_MODEL=s2.1-pro-free
# FISH_LATENCY=normal   (normal is best quality, balanced or low are faster)
